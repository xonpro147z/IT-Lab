{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xonpro147z/IT-Lab/content/wiki/schema/manifest.schema.json",
  "title": "TinHocLab – Manifest gói Bách khoa v2",
  "description": "Danh sách tệp ứng dụng được tải về. Chỉ liệt kê bài đã xuất bản. Mỗi tệp có SHA-256 để kiểm tra tải đúng; tệp nào không khớp thì bỏ qua và giữ bản cũ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "updated", "minApp", "files"],
  "properties": {
    "format": { "const": 2 },
    "version": { "type": "integer", "minimum": 1, "description": "Tăng mỗi lần xuất bản" },
    "updated": { "type": "string", "format": "date-time" },
    "minApp": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "articles": { "type": "array", "items": { "type": "string" }, "description": "Giữ lại cho bản ứng dụng cũ (≤1.21): danh sách tệp .md kiểu cũ" },
    "categories": { "type": "string", "const": "categories.json" },
    "files": {
      "type": "array", "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(articles/[a-z0-9-]+\\.json|assets/[a-z0-9-]+/[a-z0-9._-]+\\.(webp|jpg|png|svg)|categories\\.json|[a-z0-9-]+\\.md)$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 3000000 }
        }
      }
    },
    "totalBytes": { "type": "integer", "description": "Tổng dung lượng gói – ứng dụng từ chối gói vượt giới hạn cấu hình" }
  }
}

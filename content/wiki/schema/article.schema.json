{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xonpro147z/IT-Lab/content/wiki/schema/article.schema.json",
  "title": "TinHocLab – Bài viết Bách khoa (Article Schema v2)",
  "description": "Một bài viết Bách khoa lưu dạng dữ liệu có cấu trúc (khối nội dung), không lưu HTML tự do. Ứng dụng chỉ hiển thị bài có review.status = published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "slug", "title", "summary", "category", "tags", "grades", "readingTime", "hero", "variants", "references", "images", "authorship", "publishedAt", "updatedAt", "review", "versions"],
  "properties": {
    "schema": { "const": 2 },
    "id": { "$ref": "#/$defs/id", "description": "Mã bài, không đổi suốt đời bài viết" },
    "slug": { "$ref": "#/$defs/id", "description": "Đường dẫn thân thiện, có thể đổi khi đổi tiêu đề (id thì không)" },
    "kind": { "enum": ["encyclopedia", "news", "howto"], "default": "encyclopedia", "description": "Bách khoa (kiến thức lâu dài), tin công nghệ (có hạn dùng), hướng dẫn thực hành" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 300 },
    "icon": { "type": "string", "maxLength": 8 },
    "category": { "$ref": "#/$defs/id", "description": "Mã chuyên mục trong categories.json" },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 20, "uniqueItems": true },
    "aliases": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 30, "description": "Từ khoá để tìm kiếm (tiếng Anh, viết tắt…)" },
    "related": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 12 },
    "grades": { "type": "array", "items": { "$ref": "#/$defs/grade" }, "minItems": 1, "uniqueItems": true, "description": "Các cấp lớp có phiên bản nội dung" },
    "readingTime": {
      "type": "object",
      "description": "Số phút đọc của từng phiên bản",
      "propertyNames": { "$ref": "#/$defs/grade" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 60 }
    },
    "hero": { "$ref": "#/$defs/imageRef" },
    "infobox": {
      "type": "object", "additionalProperties": false, "required": ["title", "rows"],
      "properties": { "title": { "type": "string" }, "rows": { "type": "array", "maxItems": 12, "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "items": false, "minItems": 2 } } }
    },
    "variants": {
      "type": "object",
      "description": "Nội dung theo cấp lớp. Mỗi cấp trong 'grades' phải có một phiên bản.",
      "propertyNames": { "$ref": "#/$defs/grade" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["blocks"],
        "properties": {
          "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
          "quiz": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/quizItem" } }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Nguồn tham khảo THẬT đã tải được. Không bao giờ được tạo nguồn giả. Bài do pipeline AI viết phải có ít nhất quality.minSources nguồn (kiểm tra ở bước 'sources'); 18 bài cũ chuyển đổi sang có thể chưa có và được đánh dấu checks.sources = warn để giáo viên bổ sung dần.",
      "items": { "$ref": "#/$defs/reference" }
    },
    "images": {
      "type": "array",
      "description": "Danh sách mọi ảnh dùng trong bài, kèm nguồn và giấy phép",
      "items": { "$ref": "#/$defs/image" }
    },
    "authorship": {
      "type": "object", "additionalProperties": false, "required": ["ai", "editors"],
      "properties": {
        "ai": {
          "type": "object", "additionalProperties": false, "required": ["used"],
          "properties": {
            "used": { "type": "boolean" },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "steps": { "type": "array", "items": { "enum": ["research", "factcheck", "writing", "visual", "editorial"] } },
            "disclosure": { "type": "string", "description": "Câu công khai hiển thị cho học sinh" }
          }
        },
        "editors": { "type": "array", "items": { "type": "string" }, "description": "Người duyệt / biên tập (giáo viên)" }
      }
    },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "eventDate": { "type": ["string", "null"], "format": "date", "description": "Bắt buộc với kind = news: ngày xảy ra sự kiện" },
    "expiresAt": { "type": ["string", "null"], "format": "date", "description": "Ngày nên rà lại (tin tức, số liệu thay đổi nhanh)" },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["discovered", "researching", "drafted", "in_review", "approved", "published", "rejected", "archived", "needs_update"] },
        "checks": {
          "type": "object", "additionalProperties": false,
          "description": "Kết quả các bước kiểm tra bắt buộc. Chỉ xuất bản khi mọi mục = pass.",
          "required": ["schema", "sources", "factcheck", "originality", "images", "readability", "duplicate"],
          "properties": {
            "schema": { "$ref": "#/$defs/check" },
            "sources": { "$ref": "#/$defs/check" },
            "factcheck": { "$ref": "#/$defs/check" },
            "originality": { "$ref": "#/$defs/check" },
            "images": { "$ref": "#/$defs/check" },
            "readability": { "$ref": "#/$defs/check" },
            "duplicate": { "$ref": "#/$defs/check" }
          }
        },
        "reviewer": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "versions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["v", "at", "by", "change"],
        "properties": {
          "v": { "type": "integer", "minimum": 1 },
          "at": { "type": "string", "format": "date-time" },
          "by": { "type": "string", "description": "ai:<agent> hoặc tên giáo viên" },
          "change": { "type": "string", "maxLength": 300 },
          "commit": { "type": "string", "description": "Mã commit Git (lịch sử đầy đủ nằm trong Git)" }
        }
      }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "grade": { "enum": ["g3-5", "g6-8", "g9+"], "description": "Lớp 3–5, lớp 6–8, lớp 9 trở lên" },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["result"],
      "properties": {
        "result": { "enum": ["pending", "pass", "warn", "fail"] },
        "at": { "type": "string", "format": "date-time" },
        "detail": { "type": "string", "maxLength": 2000 }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["id", "url", "title", "publisher", "accessedAt", "reliability"],
      "properties": {
        "id": { "type": "string", "pattern": "^r[0-9]+$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] },
        "accessedAt": { "type": "string", "format": "date-time" },
        "reliability": { "enum": ["official", "standard", "academic", "reputable-media", "community"], "description": "Cấp độ tin cậy theo sources.json" },
        "license": { "type": ["string", "null"], "description": "Giấy phép văn bản nguồn nếu có (vd CC BY-SA 4.0)" },
        "contentHash": { "type": "string", "description": "SHA-256 văn bản nguồn lúc tải – dùng để phát hiện nguồn đã thay đổi" }
      }
    },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["id", "file", "kind", "alt", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "file": { "type": "string", "pattern": "^assets/[a-z0-9-]+/[a-z0-9._-]+\\.(webp|jpg|png|svg)$", "description": "Ảnh luôn được tải về và đóng gói cùng bài; ứng dụng không tải ảnh trực tiếp từ web" },
        "kind": { "enum": ["photo", "illustration", "diagram", "infographic", "screenshot", "logo", "ai-generated"], "description": "Phân biệt ảnh chụp thật, hình vẽ, sơ đồ và ảnh do AI tạo" },
        "alt": { "type": "string", "minLength": 5, "maxLength": 200 },
        "caption": { "type": "string", "maxLength": 300 },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "author": { "type": ["string", "null"] },
        "license": {
          "type": "object", "additionalProperties": false, "required": ["code"],
          "properties": {
            "code": { "enum": ["CC0", "PD", "CC BY", "CC BY-SA", "own", "ai-generated"], "description": "Chỉ chấp nhận giấy phép cho phép tái sử dụng. 'own' = tự vẽ (SVG trong dự án)." },
            "version": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"], "format": "uri" },
            "attribution": { "type": ["string", "null"], "description": "Dòng ghi công đầy đủ hiển thị dưới ảnh" }
          }
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "imageRef": {
      "type": "object", "additionalProperties": false, "required": ["image"],
      "properties": { "image": { "$ref": "#/$defs/id" }, "focal": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 } }
    },
    "inline": { "type": "string", "maxLength": 4000, "description": "Văn bản có đánh dấu tối giản: **đậm**, *nghiêng*, `mã`, [[id-bài|liên kết]], [^r1] chú thích nguồn. Không chấp nhận HTML." },
    "quizItem": {
      "type": "object", "additionalProperties": false, "required": ["q", "options", "answer"],
      "properties": {
        "q": { "$ref": "#/$defs/inline" },
        "options": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/inline" } },
        "answer": { "type": "integer", "minimum": 0 },
        "explain": { "$ref": "#/$defs/inline" }
      }
    },
    "claimTag": { "enum": ["fact", "opinion", "prediction"], "default": "fact", "description": "Phân biệt thông tin thực tế, ý kiến và dự đoán" },

    "block": {
      "type": "object", "required": ["type"],
      "properties": { "type": { "type": "string" } },
      "oneOf": [
        { "$ref": "#/$defs/b_heading" }, { "$ref": "#/$defs/b_text" }, { "$ref": "#/$defs/b_list" },
        { "$ref": "#/$defs/b_image" }, { "$ref": "#/$defs/b_gallery" }, { "$ref": "#/$defs/b_infographic" },
        { "$ref": "#/$defs/b_callout" }, { "$ref": "#/$defs/b_comparison" }, { "$ref": "#/$defs/b_timeline" },
        { "$ref": "#/$defs/b_diagram" }, { "$ref": "#/$defs/b_quiz" }, { "$ref": "#/$defs/b_video" },
        { "$ref": "#/$defs/b_model3d" }, { "$ref": "#/$defs/b_references" }, { "$ref": "#/$defs/b_markdown" }
      ]
    },
    "b_heading": { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "heading" }, "level": { "enum": [2, 3], "default": 2 }, "text": { "type": "string", "maxLength": 120 } } },
    "b_text": { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "text" }, "text": { "$ref": "#/$defs/inline" }, "claim": { "$ref": "#/$defs/claimTag" }, "refs": { "type": "array", "items": { "type": "string", "pattern": "^r[0-9]+$" } } } },
    "b_list": { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "list" }, "ordered": { "type": "boolean" }, "items": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/inline" } } } },
    "b_image": { "type": "object", "additionalProperties": false, "required": ["type", "image"], "properties": { "type": { "const": "image" }, "image": { "$ref": "#/$defs/id" }, "caption": { "$ref": "#/$defs/inline" }, "size": { "enum": ["inline", "wide", "full"] } } },
    "b_gallery": { "type": "object", "additionalProperties": false, "required": ["type", "images"], "properties": { "type": { "const": "gallery" }, "images": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/id" } }, "caption": { "$ref": "#/$defs/inline" } } },
    "b_infographic": {
      "type": "object", "additionalProperties": false, "required": ["type", "title", "chart"],
      "description": "Infographic vẽ bằng SVG từ dữ liệu (không phải ảnh), số liệu bắt buộc có nguồn",
      "properties": {
        "type": { "const": "infographic" }, "title": { "type": "string" },
        "chart": { "enum": ["bar", "hbar", "pie", "stat", "steps"] },
        "data": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "label": { "type": "string" }, "value": { "type": "number" }, "note": { "type": "string" } } } },
        "unit": { "type": "string" }, "refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "b_callout": { "type": "object", "additionalProperties": false, "required": ["type", "style", "text"], "properties": { "type": { "const": "callout" }, "style": { "enum": ["didyouknow", "note", "tip", "warning"] }, "title": { "type": "string" }, "text": { "$ref": "#/$defs/inline" } } },
    "b_comparison": {
      "type": "object", "additionalProperties": false, "required": ["type", "columns", "rows"],
      "properties": { "type": { "const": "comparison" }, "title": { "type": "string" }, "columns": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } }, "rows": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["label", "cells"], "properties": { "label": { "type": "string" }, "cells": { "type": "array", "items": { "$ref": "#/$defs/inline" } } } } } }
    },
    "b_timeline": {
      "type": "object", "additionalProperties": false, "required": ["type", "events"],
      "properties": { "type": { "const": "timeline" }, "title": { "type": "string" }, "events": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["date", "text"], "properties": { "date": { "type": "string", "maxLength": 20 }, "title": { "type": "string" }, "text": { "$ref": "#/$defs/inline" }, "image": { "$ref": "#/$defs/id" } } } } }
    },
    "b_diagram": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "description": "Sơ đồ kỹ thuật: dùng sơ đồ SVG có sẵn trong ứng dụng (fig) hoặc sơ đồ khối mô tả bằng dữ liệu (nodes/edges)",
      "properties": {
        "type": { "const": "diagram" }, "fig": { "type": "string", "description": "Tên sơ đồ có sẵn trong src/wiki/figs.js" },
        "nodes": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "icon": { "type": "string" } } } },
        "edges": { "type": "array", "maxItems": 24, "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 3 } },
        "layout": { "enum": ["flow", "layers", "hub"] }, "caption": { "$ref": "#/$defs/inline" }
      }
    },
    "b_quiz": { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "quiz" }, "title": { "type": "string" }, "items": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/quizItem" } } } },
    "b_video": {
      "type": "object", "additionalProperties": false, "required": ["type", "provider", "id", "title"],
      "description": "Video nhúng – chỉ phát khi máy có mạng; luôn có ảnh xem trước và tiêu đề để dùng khi không có mạng",
      "properties": { "type": { "const": "video" }, "provider": { "enum": ["youtube-nocookie", "local"] }, "id": { "type": "string" }, "title": { "type": "string" }, "poster": { "$ref": "#/$defs/id" }, "start": { "type": "integer", "minimum": 0 } }
    },
    "b_model3d": {
      "type": "object", "additionalProperties": false, "required": ["type", "target"],
      "description": "Mở mô hình 3D có sẵn trong ứng dụng (Giải phẫu máy tính / Thực hành 3D)",
      "properties": { "type": { "const": "model3d" }, "target": { "type": "string", "pattern": "^(anatomy|lab):[a-z0-9=&-]+$", "description": "vd anatomy:scale=dimm hoặc lab:motherboard" }, "caption": { "$ref": "#/$defs/inline" } }
    },
    "b_references": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "references" }, "title": { "type": "string" } } },
    "b_markdown": {
      "type": "object", "additionalProperties": false, "required": ["type", "md"],
      "description": "Khối tương thích ngược: nội dung theo cú pháp Bách khoa cũ ({{fig}}, {{photos}}, [[liên kết]], bảng, > Mẹo…). Dùng cho 18 bài hiện có trong giai đoạn chuyển đổi.",
      "properties": { "type": { "const": "markdown" }, "md": { "type": "string", "maxLength": 60000 } }
    }
  }
}

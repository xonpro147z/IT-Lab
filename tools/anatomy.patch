diff --git a/lib/assembly-mode.ts b/lib/assembly-mode.ts
new file mode 100644
index 0000000..b7ee72c
--- /dev/null
+++ b/lib/assembly-mode.ts
@@ -0,0 +1,94 @@
+/**
+ * TinHocLab – chế độ lắp ráp.
+ *
+ * Ở cấp độ cả bộ máy ('pc'), mỗi linh kiện có độ "tháo" riêng: 0 là đã lắp vào thùng,
+ * 1 là đang nằm trên khay bên cạnh. Giao diện (public/asm.js) quyết định linh kiện nào
+ * đã lắp; ở đây chỉ lo chuyển động và vị trí.
+ */
+import * as T from 'three';
+import type { Piece } from './models.ts';
+
+type Layout = () => void;
+export const asm = {
+  active: false,
+  /** Concepts already in the tower. Everything else waits on the tray. */
+  installed: new Set<string>(),
+  /** Concepts that stay in the case from the start (chassis, fans...); never on the tray. */
+  preinstalled: new Set<string>(),
+  /** Per-piece current disassembly value while pieces fly in or out. */
+  anim: new Map<Piece, number>(),
+  /** Where the tray sits, beside the tower. */
+  offset: new T.Vector3(),
+  pieces: [] as Piece[],
+  dirty: true,
+  wake: (() => {}) as () => void,
+  refit: (() => {}) as () => void,
+  layout: (() => {}) as Layout,
+  relayout: (() => {}) as Layout,
+  /** Concepts that exist in the current tower, for the UI. */
+  concepts(): string[] {
+    return [...new Set(this.pieces.map((p) => p.concept))];
+  },
+  setActive(on: boolean) {
+    this.active = on;
+    this.anim.clear();
+    this.dirty = true;
+    this.relayout();
+    this.refit();
+    this.wake();
+  },
+  install(concept: string, on = true) {
+    // Start the flight from where the piece is now: on the tray when installing.
+    for (const p of this.pieces)
+      if (p.concept === concept && !this.anim.has(p)) this.anim.set(p, on ? 1 : 0);
+    if (on) this.installed.add(concept);
+    else this.installed.delete(concept);
+    this.dirty = true;
+    this.wake();
+  },
+  reset(preinstalled: string[]) {
+    this.installed = new Set(preinstalled);
+    this.preinstalled = new Set(preinstalled);
+    this.anim.clear();
+    this.dirty = true;
+    this.relayout();
+    this.refit();
+    this.wake();
+  },
+};
+(globalThis as unknown as { __asm: typeof asm }).__asm = asm;
+// TinHocLab: cho script ngoài (đổi màu vỏ máy) dùng chung thư viện three.js của trang.
+(globalThis as unknown as { __THREE: typeof T }).__THREE = T;
+
+const target = (piece: Piece) => (asm.installed.has(piece.concept) ? 0 : 1);
+
+/** The disassembly value one piece is posed at. */
+export function asmValue(piece: Piece, level: string, value: number) {
+  if (!asm.active || level !== 'pc') return value;
+  return asm.anim.get(piece) ?? target(piece);
+}
+
+/** Extra shift for a piece's tray position. */
+export function asmShift(level: string) {
+  return asm.active && level === 'pc' ? asm.offset : null;
+}
+
+/** Advance the flights; true while anything is still moving. */
+export function asmTick(dt: number) {
+  if (!asm.active) return false;
+  let moving = asm.dirty;
+  asm.dirty = false;
+  const step = Math.min(1, dt / 1.1);
+  for (const p of asm.pieces) {
+    const goal = target(p);
+    const now = asm.anim.get(p) ?? goal;
+    if (now === goal) {
+      asm.anim.set(p, goal);
+      continue;
+    }
+    const next = goal > now ? Math.min(goal, now + step) : Math.max(goal, now - step);
+    asm.anim.set(p, next);
+    moving = true;
+  }
+  return moving;
+}
